TEST(IntervalTest, ConvertUnitsDownwards) {
    auto interval{Interval({
        .years = 1,
        .months = 2,
        .weeks = 3,
        .days = 4,
        .hours = 5,
        .minutes = 6,
    })};

    auto converted{interval.convertUnitsDownwards()};
    EXPECT_EQ(converted[Unit::YEAR], 0);
    EXPECT_EQ(converted[Unit::MONTH], 14);
    EXPECT_EQ(converted[Unit::WEEK], 0);
    EXPECT_EQ(converted[Unit::DAY], 0);
    EXPECT_EQ(converted[Unit::HOUR], 0);
    EXPECT_EQ(converted[Unit::MINUTE], 36306);

    interval = Interval::minutes(100);
    EXPECT_TRUE(
        interval.convertUnitsDownwards().onlyContainsUnit(Unit::MINUTE));
    EXPECT_EQ(interval.convertUnitsDownwards()[Unit::MINUTE], 100);

    interval = Interval::months(100);
    EXPECT_TRUE(interval.convertUnitsDownwards().onlyContainsUnit(Unit::MONTH));
    EXPECT_EQ(interval.convertUnitsDownwards()[Unit::MONTH], 100);

    EXPECT_TRUE(Interval().convertUnitsDownwards().isZero());
}

TEST(IntervalTest, OnlyContainsUnit) {
    auto allExceptUnitAreZero{[](Interval interval, Unit exceptUnit) -> bool {
        for (auto unit : Interval::units) {
            if (unit == exceptUnit && interval[unit] == 0) {
                return false;
            }

            if (unit != exceptUnit && interval[unit] != 0) {
                return false;
            }
        }

        return true;
    }};

    EXPECT_TRUE(allExceptUnitAreZero(Interval::minutes(5), Unit::MINUTE));

    EXPECT_TRUE(allExceptUnitAreZero(Interval::hours(5), Unit::HOUR));

    EXPECT_TRUE(allExceptUnitAreZero(Interval::days(5), Unit::DAY));

    EXPECT_TRUE(allExceptUnitAreZero(Interval::weeks(5), Unit::WEEK));

    EXPECT_TRUE(allExceptUnitAreZero(Interval::months(5), Unit::MONTH));

    EXPECT_TRUE(allExceptUnitAreZero(Interval::years(5), Unit::YEAR));

    auto interval{Interval({
        .years = 1,
        .months = 2,
        .weeks = 3,
        .days = 4,
        .hours = 5,
        .minutes = 6,
    })};

    /* interval with all units */
    for (const auto unit : Interval::units) {
        EXPECT_FALSE(allExceptUnitAreZero(interval, unit));
    }

    /* empty interval */
    for (const auto unit : Interval::units) {
        EXPECT_FALSE(Interval().onlyContainsUnit(unit));
    }
}

