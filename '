TEST(IntervalTest, ISO8601ParserParsesValidInputs) {
    auto result{Interval::fromISO8601String("PT0M")};
    ASSERT_TRUE(result.has_value());
    EXPECT_TRUE(result->isZero());

    result = Interval::fromISO8601String("PT1M");
    ASSERT_TRUE(result.has_value());
    EXPECT_EQ(result.value()[Unit::MINUTE], 1);

    result = Interval::fromISO8601String("PT1H1M");
    ASSERT_TRUE(result.has_value());
    EXPECT_EQ(result.value()[Unit::HOUR], 1);
    EXPECT_EQ(result.value()[Unit::MINUTE], 1);

    result = Interval::fromISO8601String("P1Y2M3W4DT5H6M");
    ASSERT_TRUE(result.has_value());
    EXPECT_EQ(result.value()[Unit::YEAR], 1);
    EXPECT_EQ(result.value()[Unit::MONTH], 2);
    EXPECT_EQ(result.value()[Unit::WEEK], 3);
    EXPECT_EQ(result.value()[Unit::DAY], 4);
    EXPECT_EQ(result.value()[Unit::HOUR], 5);
    EXPECT_EQ(result.value()[Unit::MINUTE], 6);
}

