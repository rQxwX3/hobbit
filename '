TEST(IntervalTest, OperatorPlusOnSameMonthHandling) {
    auto first{Interval({
        .years = 1,
        .months = 1,
        .weeks = 1,
        .days = 1,
        .hours = 1,
        .minutes = 1,
    })};

    auto second{Interval({.years = 1,
                          .months = 2,
                          .weeks = 3,
                          .days = 4,
                          .hours = 5,
                          .minutes = 6})};

    auto result{first + second};

    /* x + y == y + x*/
    EXPECT_EQ(result, second + first);

    /* (x + y) + z == x + (y + z) */
    EXPECT_EQ(result + Interval::days(1), first + (second + Interval::days(1)));

    EXPECT_EQ(result[Unit::YEAR], 2);
    EXPECT_EQ(result[Unit::MONTH], 3);
    EXPECT_EQ(result[Unit::WEEK], 4);
    EXPECT_EQ(result[Unit::DAY], 5);
    EXPECT_EQ(result[Unit::HOUR], 6);
    EXPECT_EQ(result[Unit::MINUTE], 7);
}

TEST(IntervalTest, OperatorPlusOnDiffMonthHandlingPreservesFirst) {
    using Handling = Interval::MonthHandling;

    auto first{Interval(
        {
            .years = 1,
            .months = 1,
            .weeks = 1,
            .days = 1,
            .hours = 1,
            .minutes = 1,
        },
        Handling::PreserveRelative)};

    auto second{Interval({.years = 1,
                          .months = 2,
                          .weeks = 3,
                          .days = 4,
                          .hours = 5,
                          .minutes = 6},
                         Handling::WrapAround)};

    EXPECT_EQ((first + second).getMonthHandling(), first.getMonthHandling());
    EXPECT_EQ((second + first).getMonthHandling(), second.getMonthHandling());
}

TEST(IntervalTest, ComparisonOperators) {
    EXPECT_FALSE(Interval() > Interval());
    EXPECT_FALSE(Interval() < Interval());

    EXPECT_TRUE(Interval() >= Interval());
    EXPECT_TRUE(Interval() <= Interval());

    EXPECT_TRUE(Interval() == Interval());
    EXPECT_FALSE(Interval() != Interval());

    EXPECT_TRUE(Interval::minutes(1) > Interval());

    /* years v. months */
    EXPECT_TRUE(Interval::years(1) <
                Interval::months(Interval::monthsInYear + 1));

    EXPECT_TRUE(Interval::years(1) == Interval::months(Interval::monthsInYear));

    EXPECT_TRUE(Interval::years(1) >
                Interval::months(Interval::monthsInYear - 1));

    /* weeks v. days */
    EXPECT_TRUE(Interval::weeks(1) < Interval::days(Interval::daysInWeek + 1));

    EXPECT_TRUE(Interval::weeks(1) == Interval::days(Interval::daysInWeek));

    EXPECT_TRUE(Interval::weeks(1) > Interval::days(Interval::daysInWeek - 1));

    /* days v. hours */
    EXPECT_TRUE(Interval::days(1) < Interval::hours(Interval::hoursInDay + 1));

    EXPECT_TRUE(Interval::days(1) == Interval::hours(Interval::hoursInDay));

    EXPECT_TRUE(Interval::days(1) > Interval::hours(Interval::hoursInDay - 1));

    /* hours v. minutes */
    EXPECT_TRUE(Interval::hours(1) <
                Interval::minutes(Interval::minutesInHour + 1));

    EXPECT_TRUE(Interval::hours(1) ==
                Interval::minutes(Interval::minutesInHour));

    EXPECT_TRUE(Interval::hours(1) >
                Interval::minutes(Interval::minutesInHour - 1));

    /* months v. minutes (valid) */
    EXPECT_TRUE(Interval::months(1) > Interval::minutes(1));
    EXPECT_TRUE(Interval::months(1) > Interval::minutes(10000));
    EXPECT_TRUE(Interval::months(144) > Interval::minutes(10000));

    /* invalid comparisons */
    EXPECT_THROW(Interval({.months = 1, .minutes = 1}) < Interval::days(1),
                 std::logic_error);
}

TEST(IntervalTest, IsMultipleOf) {
    EXPECT_FALSE(Interval().isMultipleOf(Interval::days(1)));
    EXPECT_FALSE(Interval::days(1).isMultipleOf(Interval()));

    EXPECT_TRUE(Interval::days(1).isMultipleOf(Interval::days(1)));

    EXPECT_TRUE(Interval::days(10).isMultipleOf(Interval::days(5)));

    EXPECT_FALSE(Interval::days(9).isMultipleOf(Interval::days(5)));

    /* years v. months */
    EXPECT_TRUE(Interval::years(1).isMultipleOf(Interval::months(1)));
    EXPECT_TRUE(Interval::years(100).isMultipleOf(Interval::months(1)));
    EXPECT_TRUE(Interval::years(100).isMultipleOf(Interval::months(2)));

    /* weeks v. days */
    EXPECT_TRUE(Interval::weeks(1).isMultipleOf(Interval::days(1)));
    EXPECT_TRUE(Interval::weeks(100).isMultipleOf(Interval::days(1)));
    EXPECT_TRUE(Interval::weeks(100).isMultipleOf(Interval::days(2)));

    /* days v. hours */
    EXPECT_TRUE(Interval::days(1).isMultipleOf(Interval::hours(1)));
    EXPECT_TRUE(Interval::days(100).isMultipleOf(Interval::hours(1)));
    EXPECT_TRUE(Interval::days(100).isMultipleOf(Interval::hours(2)));

    /* hours v. minutes */
    EXPECT_TRUE(Interval::hours(1).isMultipleOf(Interval::minutes(1)));
    EXPECT_TRUE(Interval::hours(100).isMultipleOf(Interval::minutes(1)));
    EXPECT_TRUE(Interval::hours(100).isMultipleOf(Interval::minutes(2)));

    auto i0{Interval{Interval::Units{.years = 100,
                                     .months = 100,
                                     .weeks = 100,
                                     .days = 100,
                                     .hours = 100,
                                     .minutes = 100}}};

    auto i1{Interval{Interval::Units{.years = 2,
                                     .months = 2,
                                     .weeks = 2,
                                     .days = 2,
                                     .hours = 2,
                                     .minutes = 2}}};

    auto i2{Interval{Interval::Units{.years = 1,
                                     .months = 1,
                                     .weeks = 1,
                                     .days = 1,
                                     .hours = 1,
                                     .minutes = 1}}};

    EXPECT_TRUE(i1.isMultipleOf(i2));
    EXPECT_TRUE(i0.isMultipleOf(i1));
    EXPECT_TRUE(i0.isMultipleOf(i2));
}

TEST(IntervalTest, NaturalLanguageParserParsesValidInputs) {
    auto result{Interval::fromNaturalLanguage(
        "1year 2months 3weeks 4days 5hours 6minutes")};
    ASSERT_TRUE(result);

    EXPECT_EQ(result.value()[Unit::YEAR], 1);
    EXPECT_EQ(result.value()[Unit::MONTH], 2);
    EXPECT_EQ(result.value()[Unit::WEEK], 3);
    EXPECT_EQ(result.value()[Unit::DAY], 4);
    EXPECT_EQ(result.value()[Unit::HOUR], 5);
    EXPECT_EQ(result.value()[Unit::MINUTE], 6);

    result = Interval::fromNaturalLanguage("1y2m3w4d5h6min");
    ASSERT_TRUE(result);

    result = Interval::fromNaturalLanguage("1Y 2MoNtHs 3W 4D 5H 6MiN");
    ASSERT_TRUE(result);
}

TEST(IntervalTest, NaturalLanguageParserHandlesFiltering) {
    auto result{Interval::fromNaturalLanguage("!@# 1 year !! 2 months @@")};
    ASSERT_TRUE(result);

    EXPECT_EQ(result.value()[Unit::YEAR], 1);
    EXPECT_EQ(result.value()[Unit::MONTH], 2);
}
TEST(IntervalTest, NaturalLanguageParserRejectsInvalidInputs) {
    auto result{Interval::fromNaturalLanguage("")};
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("hello");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("1234");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("!@#$%^&*()");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("year");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("year1");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("1yesterday");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("1.5years");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("1/5years");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    auto invalidValue{static_cast<uint64_t>(Interval::maxValue) + 1};
    auto invalidString{"P" + std::to_string(invalidValue) + "Y"};

    result = Interval::fromNaturalLanguage(invalidString);
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);
    EXPECT_FALSE();
}

