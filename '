TEST(IntervalTest, GetNonZeroUnitValuePairs) {
    auto interval{Interval({
        .years = 1,
        .months = 2,
        .weeks = 3,
        .days = 4,
        .hours = 5,
        .minutes = 6,
    })};

    EXPECT_THAT(
        interval.getNonZeroUnitValuePairs(),
        testing::ElementsAre(
            std::make_pair(Unit::YEAR, 1), std::make_pair(Unit::MONTH, 2),
            std::make_pair(Unit::WEEK, 3), std::make_pair(Unit::DAY, 4),
            std::make_pair(Unit::HOUR, 5), std::make_pair(Unit::MINUTE, 6)));

    EXPECT_THAT(Interval({
                             .years = 1,
                             .weeks = 1,
                             .hours = 1,
                         })
                    .getNonZeroUnitValuePairs(),
                testing::ElementsAre(std::make_pair(Unit::YEAR, 1),
                                     std::make_pair(Unit::WEEK, 1),
                                     std::make_pair(Unit::HOUR, 1)));

    EXPECT_THAT(Interval({.minutes = 1}).getNonZeroUnitValuePairs(),
                testing::ElementsAre(std::make_pair(Unit::MINUTE, 1)));

    EXPECT_TRUE(Interval().getNonZeroUnitValuePairs().empty());
}

