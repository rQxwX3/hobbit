    result = Interval::fromNaturalLanguage("1y 2months 3mo");
    ASSERT_FALSE(result);
    EXPECT_EQ(result.error(), Interval::Error::NaturalLanguageFailedToParse);

    result = Interval::fromNaturalLanguage("1 year 2 years 3 years");
    ASSERT_FALSE(result);
