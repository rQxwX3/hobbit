TEST(IntervalTest, DefaultConstructor) {
    auto interval{Interval()};

    EXPECT_EQ(interval.getMonthHandling(), Interval::defaultMonthHandling);
    EXPECT_EQ(interval[Unit::YEAR], 0);
    EXPECT_EQ(interval[Unit::MONTH], 0);
    EXPECT_EQ(interval[Unit::WEEK], 0);
    EXPECT_EQ(interval[Unit::DAY], 0);
    EXPECT_EQ(interval[Unit::HOUR], 0);
    EXPECT_EQ(interval[Unit::MINUTE], 0);
}

TEST(IntervalTest, CtorThrowsOnInvalidMonthHandling) {
